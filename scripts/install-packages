#!/usr/bin/env bash

# Package installation script for Ubuntu 24.04 / 26.04
#
# Usage: install-packages [GROUP...]
# Without arguments every group is installed. Run with --list to see groups.

set -e

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

e_header() { echo -e "${BLUE}==>${NC} $1"; }
e_success() { echo -e "${GREEN}✓${NC} $1"; }
e_warning() { echo -e "${YELLOW}!${NC} $1"; }

# Groups in install order (rust before zellij so cargo is available)
ALL_GROUPS=(core terminal starship rust zellij cargo node lazygit lazydocker neovim python ohmyzsh fonts)

# Install apt packages, skipping ones not available in this Ubuntu release
apt_install() {
    local available=()
    for pkg in "$@"; do
        if apt-cache show "$pkg" &>/dev/null; then
            available+=("$pkg")
        else
            e_warning "Package '$pkg' not available on this release, skipping"
        fi
    done
    if [ ${#available[@]} -gt 0 ]; then
        sudo apt install -y "${available[@]}"
    fi
}

install_core() {
    e_header "Updating system packages..."
    sudo apt update

    e_header "Installing core packages..."
    apt_install build-essential curl wget git zsh stow unzip tar
}

install_terminal() {
    e_header "Installing terminal tools..."
    apt_install alacritty tilix cool-retro-term tmux fzf ripgrep fd-find bat tree jq btop
    # neofetch is dropped in newer releases, fastfetch replaces it
    apt_install neofetch fastfetch 2>/dev/null || true

    # Create fd symlink
    sudo ln -sf "$(which fdfind)" /usr/local/bin/fd 2>/dev/null || true
}

install_starship() {
    if ! command -v starship &> /dev/null; then
        e_header "Installing Starship..."
        curl -sS https://starship.rs/install.sh | sh -s -- -y
        e_success "Starship installed"
    fi
}

install_rust() {
    if ! command -v cargo &> /dev/null; then
        e_header "Installing Rust..."
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
        e_success "Rust installed"
    fi
    [ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
    return 0
}

install_zellij() {
    if ! command -v zellij &> /dev/null; then
        e_header "Installing Zellij..."
        local tmp_dir version
        tmp_dir=$(mktemp -d)
        version=$(curl -s https://api.github.com/repos/zellij-org/zellij/releases/latest | grep -Po '"tag_name": "v\K[^"]*')
        wget -O "$tmp_dir/zellij.tar.gz" "https://github.com/zellij-org/zellij/releases/download/v${version}/zellij-x86_64-unknown-linux-musl.tar.gz"
        tar -xzf "$tmp_dir/zellij.tar.gz" -C "$tmp_dir"
        sudo install "$tmp_dir/zellij" /usr/local/bin/
        rm -rf "$tmp_dir"
        e_success "Zellij installed"
    fi
}

install_cargo() {
    [ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
    if command -v cargo &> /dev/null; then
        e_header "Installing Rust packages..."
        # --locked uses each crate's tested dependency versions, newer deps can break the build
        for crate in eza zoxide; do
            cargo install --locked "$crate" || e_warning "Failed to install $crate"
        done
        # yazi-fm/yazi-cli must be built through yazi-build (installs yazi and ya)
        if ! command -v yazi &> /dev/null; then
            cargo install --force --locked yazi-build || e_warning "Failed to install yazi"
        fi
    else
        e_warning "cargo not found, skipping Rust packages (select 'rust' too)"
    fi
}

install_node() {
    # Current LTS major from nodejs.org, fall back to a known LTS if offline
    local lts_major current_major
    lts_major=$(curl -fsSL https://nodejs.org/dist/index.json 2>/dev/null \
        | grep -Po '"version":"v\K[0-9]+(?=[^}]*"lts":")' | head -1)
    lts_major=${lts_major:-24}
    current_major=$(node -v 2>/dev/null | grep -Po '^v\K[0-9]+' || echo 0)

    if [ "$current_major" -lt "$lts_major" ]; then
        e_header "Installing Node.js $lts_major LTS (current: ${current_major/#0/none})..."
        # Ubuntu's npm/libnode-dev packages conflict with NodeSource's nodejs (which bundles npm)
        local conflicts=()
        for pkg in npm libnode-dev nodejs-doc; do
            dpkg -s "$pkg" &>/dev/null && conflicts+=("$pkg")
        done
        if [ ${#conflicts[@]} -gt 0 ]; then
            sudo apt remove -y "${conflicts[@]}"
        fi
        curl -fsSL https://deb.nodesource.com/setup_lts.x | sudo -E bash -
        sudo apt install -y nodejs
        e_success "Node.js $(node -v) installed"
    fi

    # Install global npm packages into ~/.local (on PATH) instead of root-owned /usr/local
    e_header "Installing npm packages..."
    npm install -g --prefix "$HOME/.local" tree-sitter-cli pnpm
}

install_lazygit() {
    if ! command -v lazygit &> /dev/null; then
        e_header "Installing Lazygit..."
        local tmp_dir version
        tmp_dir=$(mktemp -d)
        version=$(curl -s "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | grep -Po '"tag_name": "v\K[^"]*')
        curl -Lo "$tmp_dir/lazygit.tar.gz" "https://github.com/jesseduffield/lazygit/releases/latest/download/lazygit_${version}_Linux_x86_64.tar.gz"
        tar xf "$tmp_dir/lazygit.tar.gz" -C "$tmp_dir" lazygit
        sudo install "$tmp_dir/lazygit" /usr/local/bin
        rm -rf "$tmp_dir"
        e_success "Lazygit installed"
    fi
}

install_lazydocker() {
    if ! command -v lazydocker &> /dev/null; then
        e_header "Installing Lazydocker..."
        curl https://raw.githubusercontent.com/jesseduffield/lazydocker/master/scripts/install_update_linux.sh | bash
        e_success "Lazydocker installed"
    fi
}

install_neovim() {
    if [ ! -f /opt/nvim-linux-x86_64/bin/nvim ]; then
        e_header "Installing Neovim..."
        local tmp_dir
        tmp_dir=$(mktemp -d)
        curl -Lo "$tmp_dir/nvim.tar.gz" https://github.com/neovim/neovim/releases/latest/download/nvim-linux-x86_64.tar.gz
        sudo rm -rf /opt/nvim-linux-x86_64
        sudo tar -C /opt -xzf "$tmp_dir/nvim.tar.gz"
        rm -rf "$tmp_dir"
        sudo ln -sf /opt/nvim-linux-x86_64/bin/nvim /usr/local/bin/nvim
        e_success "Neovim installed"
    fi
}

install_python() {
    # pip --user is blocked by PEP 668 on Ubuntu 24.04+, use apt packages instead
    e_header "Installing Python packages..."
    apt_install python3-pynvim python3-greenlet
}

install_ohmyzsh() {
    if [ ! -d "$HOME/.oh-my-zsh" ]; then
        e_header "Installing Oh My Zsh..."
        sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
        e_success "Oh My Zsh installed"
    fi

    local custom="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
    if [ ! -d "$custom/plugins/zsh-autosuggestions" ]; then
        git clone https://github.com/zsh-users/zsh-autosuggestions "$custom/plugins/zsh-autosuggestions"
    fi
    if [ ! -d "$custom/plugins/zsh-syntax-highlighting" ]; then
        git clone https://github.com/zsh-users/zsh-syntax-highlighting.git "$custom/plugins/zsh-syntax-highlighting"
    fi
}

install_fonts() {
    if ! fc-list | grep -q "CaskaydiaMono"; then
        e_header "Installing Nerd Fonts..."
        local tmp_dir
        tmp_dir=$(mktemp -d)
        mkdir -p ~/.local/share/fonts
        wget -q -O "$tmp_dir/CascadiaMono.zip" https://github.com/ryanoasis/nerd-fonts/releases/download/v3.1.1/CascadiaMono.zip
        unzip -oq "$tmp_dir/CascadiaMono.zip" -d ~/.local/share/fonts
        rm -rf "$tmp_dir"
        fc-cache -f
        e_success "Nerd Fonts installed"
    fi
}

if [ "$1" = "--list" ]; then
    printf '%s\n' "${ALL_GROUPS[@]}"
    exit 0
fi

SELECTED=("$@")
[ ${#SELECTED[@]} -eq 0 ] && SELECTED=("${ALL_GROUPS[@]}")

# Validate selection
for group in "${SELECTED[@]}"; do
    if ! declare -F "install_$group" >/dev/null; then
        echo "Unknown group: $group (available: ${ALL_GROUPS[*]})" >&2
        exit 1
    fi
done

# Run selected groups in canonical order
for group in "${ALL_GROUPS[@]}"; do
    if [[ " ${SELECTED[*]} " == *" $group "* ]]; then
        "install_$group"
    fi
done

echo ""
e_success "All selected packages installed successfully!"
